# ── Bao Teck Tea House — Apache configuration ─────────────────────────
# Most shared hosting (cPanel, Hostinger, GoDaddy) uses Apache and will
# read this file automatically. If your host uses nginx, use the
# nginx.conf file in the /server folder instead.

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  # HSTS — only switch this on once HTTPS is working
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Never serve the admin editor or backups to the public ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^admin/ - [F,L]
</IfModule>
<FilesMatch "\.(bak|old|log|sql|zip)$">
  Require all denied
</FilesMatch>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 6 months"
  ExpiresByType image/png       "access plus 6 months"
  ExpiresByType image/svg+xml   "access plus 6 months"
  ExpiresByType text/css        "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  # Content files must stay fresh so owner edits appear immediately
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html       "access plus 0 seconds"
</IfModule>

# --- Correct character encoding for all 7 languages ---
AddDefaultCharset UTF-8
AddType application/json .json
AddType application/manifest+json .webmanifest

ErrorDocument 404 /index.html
